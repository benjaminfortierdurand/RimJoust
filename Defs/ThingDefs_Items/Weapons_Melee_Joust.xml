	<ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
		<defName>RimJoust_TourneyMace</defName>
		<label>tourney mace</label>
		<description>A blunted melee mace made to bruise and disarm rather than kill. Handed out to every fighter at the start of a grand melee, and taken back afterwards. Nobody really wants to find out what happens with real swords.</description>
		<possessionCount>1</possessionCount>

