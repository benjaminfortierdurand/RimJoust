<Defs>

	<ThingDef ParentName="BaseMeleeWeapon_Blunt_Quality">
		<defName>RimJoust_JoustingLance</defName>
		<label>jousting lance</label>
		<description>A long tournament lance with a blunt coronal head. It is made to knock an opponent off his horse, not to kill him. It often breaks on impact, which is normal in a joust and usually means the blow landed well.</description>
		<possessionCount>1</possessionCount>

		<graphicData>
			<texPath>Things/Item/Equipment/WeaponMelee/RimJoust_JoustingLance</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.7, 1.7)</drawSize>
		</graphicData>
		<uiIconScale>1.0</uiIconScale>

		<techLevel>Medieval</techLevel>
		<costStuffCount>120</costStuffCount>

		<statBases>
			<WorkToMake>8000</WorkToMake>
			<Mass>5</Mass>
		</statBases>

		<equippedAngleOffset>-65</equippedAngleOffset>

		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>

		<weaponClasses>
			<li>Melee</li>
