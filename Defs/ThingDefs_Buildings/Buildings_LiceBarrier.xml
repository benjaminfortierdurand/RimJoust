<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>RimJoust_LiceBarrier</defName>
		<label>tournament list</label>
		<description>A tournament barrier, a sturdy wooden fence about knee-high to a mounted knight. It splits the joust into two lanes so the horses don't run into each other. Place a straight row between the 2 flags. It connects to other fences on its own.</description>

		<thingClass>Building</thingClass>
		<category>Building</category>

		<graphicData>
			<texPath>Things/Building/Linked/Fence</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<linkType>Asymmetric</linkType>
			<linkFlags>
				<li>Fences</li>
			</linkFlags>
			<asymmetricLink>
				<linkFlags>
					<li>Wall</li>
					<li>Rock</li>
				</linkFlags>
			</asymmetricLink>
			<shadowData>
				<volume>(0.3, 0.5, 0.3)</volume>
				<offset>(0,0,-0.23)</offset>
			</shadowData>
			<damageData>
				<rect>(0.35,0.1,0.3,0.7)</rect>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Linked/Fence_MenuIcon</uiIconPath>

		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>80</pathCost>
		<blockWind>false</blockWind>
		<fillPercent>0.30</fillPercent>
		<coversFloor>false</coversFloor>
		<drawStyleCategory>Defenses</drawStyleCategory>
		<canOverlapZones>false</canOverlapZones>
		<neverMultiSelect>true</neverMultiSelect>

		<useHitPoints>true</useHitPoints>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Flammability>1.0</Flammability>
		</statBases>

		<costStuffCount>5</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>

		<building>
			<isEdifice>true</isEdifice>
			<isPlayerEjectable>true</isPlayerEjectable>
		</building>

		<designationCategory>Misc</designationCategory>
		<constructionSkillPrerequisite>0</constructionSkillPrerequisite>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<tickerType>Never</tickerType>
		<leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
	</ThingDef>

</Defs>
