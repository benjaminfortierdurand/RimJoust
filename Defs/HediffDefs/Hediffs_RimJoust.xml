<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef>
		<defName>RimJoust_HardFall</defName>
		<label>hard fall</label>
		<labelNoun>a hard fall</labelNoun>
		<description>A hard fall from a horse at full gallop. The knight lies flat for a while, long enough to get carried off, then gets back up dazed and wobbly, and stays sore for a few hours. The armor does its job: spectacular, rarely serious.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.85, 0.6, 0.2)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<maxSeverity>1.0</maxSeverity>
		<isBad>true</isBad>

		<comps>
			<li Class="RimJoust.HediffCompProperties_RandomSeverityPerDay">
				<recoveryHoursRange>1~4</recoveryHoursRange>
				<showHoursToRecover>true</showHoursToRecover>
			</li>
		</comps>

		<stages>
			<li>
				<label>aching</label>
				<minSeverity>0</minSeverity>
				<capMods>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.10</offset>
					</li>
				</capMods>
				<painOffset>0.05</painOffset>
			</li>

			<li>
				<label>dazed</label>
				<minSeverity>0.35</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.20</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.30</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.25</offset>
					</li>
				</capMods>
				<painOffset>0.12</painOffset>
			</li>

			<li>
				<label>down</label>
				<minSeverity>0.75</minSeverity>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<offset>-0.75</offset>
					</li>
					<li>
						<capacity>Moving</capacity>
						<offset>-0.60</offset>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<offset>-0.50</offset>
					</li>
				</capMods>
				<painOffset>0.25</painOffset>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>RimJoust_ChampionRenown</defName>
		<label>champion's renown</label>
		<labelNoun>a champion's renown</labelNoun>
		<description>After winning the jousting tournament, this knight has a lot of prestige. People listen to him and his charisma impresses everyone, at least for a while.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(0.9, 0.78, 0.3)</defaultLabelColor>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<maxSeverity>1.0</maxSeverity>
		<initialSeverity>1.0</initialSeverity>

		<comps>
			<li Class="HediffCompProperties_Disappears">
				<disappearsAfterTicks>300000</disappearsAfterTicks>
				<showRemainingTime>true</showRemainingTime>
			</li>
		</comps>

		<stages>
			<li>
				<statOffsets>
					<SocialImpact>0.3</SocialImpact>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

	<HediffDef>
		<defName>RimJoust_TourneyMount</defName>
		<label>tournament mount</label>
		<description>This mount is ready for the list. It charges at a full gallop.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<scenarioCanAdd>false</scenarioCanAdd>
		<isBad>false</isBad>
		<maxSeverity>1.0</maxSeverity>
		<initialSeverity>1.0</initialSeverity>

		<stages>
			<li>
				<statOffsets>
					<MoveSpeed>3.5</MoveSpeed>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>

</Defs>
